**/.amo_libs/

# OS / sync clutter
desktop.ini
Thumbs.db
.DS_Store

# Editor
.vscode/

# Python caches and virtualenvs (Project 5)
__pycache__/
*.py[cod]
.venv/
venv/
.streamlit/secrets.toml

